{
    "name": "default",
    "typography": {
        "enabled": true,
        "defaultFonts": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "fontSize": "16px",
        "customFonts": [
            {
                "name": "Iceberg",
                "preload": true,
                "sources": {
                    "woff2": "/fonts/Iceberg/Iceberg-Regular.woff2"
                },
                "weight": "normal",
                "style": "normal"
            }
        ]
    },
    "customScrollbar": {
        "enabled": true,
        "width": "auto",
        "borderRadius": "8px",
        "borderWidth": "3px",
        "colors": {
            "thumb": "primary",
            "thumbHover": "secondary",
            "track": "background2",
            "border": "background3"
        }
    },
    "customCursor": {
        "enabled": false,
        "cursors": {
            "default": {
                "path": "/images/ui/cursor/cursor.png",
                "hotspot": "0 0"
            },
            "pointer": {
                "path": "/images/ui/cursor/cursor-hand.png",
                "hotspot": "0 0"
            },
            "text": {
                "path": "/images/ui/cursor/cursor-text.png",
                "hotspot": "12 12"
            }
        },
        "_comment": "default | pointer | text"
    },
    "colors": {
        "enabled": true,
        "defaults": true,
        "defaultColor": "dark",
        "themes": {
            "system": {
                "translations": {
                    "pt-BR": "Automático",
                    "en-US": "Automatic"
                },
                "icon": "i-line-md:light-dark-loop"
            },
            "dark": {
                "dark": true,
                "primary": "#FF6B6B",
                "secondary": "#FFB96A",
                "accent": "#82B1FF",
                "error": "#FF5252",
                "info": "#2196F3",
                "success": "#4CAF50",
                "warning": "#FCCF3D",
                "background": "#0F0F0F",
                "background2": "#191919",
                "background3": "#232323",
                "translations": {
                    "pt-BR": "Escuro",
                    "en-US": "Dark"
                },
                "icon": "i-line-md:sunny-filled-loop-to-moon-filled-transition"
            },
            "light": {
                "dark": false,
                "primary": "#FF0000",
                "secondary": "#FF8800",
                "accent": "#82B1FF",
                "error": "#FF5252",
                "info": "#2196F3",
                "success": "#4CAF50",
                "warning": "#FCCF3D",
                "background": "#FAFAFA",
                "background2": "#F0F0F0",
                "background3": "#E6E6E6",
                "translations": {
                    "pt-BR": "Claro",
                    "en-US": "Light"
                },
                "icon": "i-line-md:moon-filled-to-sunny-filled-transition"
            },
            "carnaval": {
                "dark": true,
                "seasonal": true,
                "dateRange": {
                    "start": "02-14",
                    "end": "03-05"
                },
                "primary": "#FF1493",
                "secondary": "#FFD000",
                "accent": "#00D4AA",
                "error": "#FF0000",
                "info": "#00BFFF",
                "success": "#32CD32",
                "warning": "#FF8C00",
                "background": "#1A001A",
                "background2": "#2D002D",
                "background3": "#400040",
                "translations": {
                    "pt-BR": "Carnaval",
                    "en-US": "Carnival"
                },
                "icon": "i-line-md:emoji-grin"
            },
            "natal": {
                "dark": true,
